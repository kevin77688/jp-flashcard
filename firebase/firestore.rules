rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Personal app: only the owner's account may read or write, and only under its own /users/{uid}.
    // Anyone else who signs in (e.g. through the public web page) gets nothing and cannot store data.
    // The UID is an opaque Firebase account id, not personal information.
    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && uid == 'SFwV6DvGIXeWsfdWeExUIJpqUPC2';
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }
  }
}
